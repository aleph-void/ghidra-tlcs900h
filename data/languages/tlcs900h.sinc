# TLCS-900/H sleigh include file
#
# Encodings and operation follow the Toshiba TLCS-900 CPU manual (900, 900/L, 900/H core book,
# "Appendix B Instruction Lists" and "Appendix C Instruction Code Maps"). An instruction is a
# first byte (an addressing prefix: register, memory operand or one-byte op code), the extension
# bytes of that prefix, then the operation byte and its immediate data. The prefixes are the
# variable-length subtables rB/rW/rL (register "r"), smB/smW/smL (source memory) and dmA
# (destination memory, an effective address).

define pcodeop halt;

define token opbyte (8)
   op     = (0,7)
   op_hi  = (4,7)
   op_lo  = (0,3)
   op_cc  = (0,3)
   op_r   = (0,2)
   op_0   = (0,0)
   op_3   = (3,3)
   op_sz  = (4,5)
   op_6   = (6,6)
   op_7   = (7,7)
   R8     = (0,2)
   R16    = (0,2)
   R32    = (0,2)
   RRb    = (1,2)
   imm3   = (0,2)
;

define token extbyte (8)
   x      = (0,7)
   x_hi   = (4,7)
   x_lo   = (0,3)
   x_zz   = (0,1)
   x_0    = (0,0)
   x_01   = (0,1)
   xb8    = (0,7)
   xw7    = (1,7)
   xl6    = (2,7)
   x_wsub = (1,3)
   x_lsub = (2,3)
   x_7    = (7,7)
   xa     = (0,7)
   xb     = (0,7)
   xc     = (0,7)
   xs     = (0,7) signed
   xbs    = (0,7) signed
;

define token extbyte2 (8)
   y_hi   = (4,7)
   y_lo   = (0,3)
   y_0    = (0,0)
   yb8    = (0,7)
   yw7    = (1,7)
;

define token data8 (8)
   imm8  = (0,7)
   simm8 = (0,7) signed
   imm4  = (0,3)
   imm8_hi = (4,7)
   d8_37 = (3,7)
   imm3d = (0,2)
   d8s   = (7,7)
;
define token data16 (16)
   imm16  = (0,15)
   simm16 = (0,15) signed
   d16s   = (15,15)
;
define token data24 (24)
   imm24 = (0,23)
   d24s  = (23,23)
;
define token data32 (32)
   imm32 = (0,31)
;

attach variables [ R32 ] [ XWA XBC XDE XHL XIX XIY XIZ XSP ];
attach variables [ R16 ] [ WA BC DE HL IX IY IZ SP ];
attach variables [ R8  ] [ W A B C D E H L ];
attach variables [ RRb ] [ WA BC DE HL ];
attach variables [ xb8 yb8 ] [
    RA_0    RW_0    QA_0    QW_0    RC_0    RB_0    QC_0    QB_0    RE_0    RD_0    QE_0    QD_0    RL_0    RH_0    QL_0    QH_0   
    RA_1    RW_1    QA_1    QW_1    RC_1    RB_1    QC_1    QB_1    RE_1    RD_1    QE_1    QD_1    RL_1    RH_1    QL_1    QH_1   
    RA_2    RW_2    QA_2    QW_2    RC_2    RB_2    QC_2    QB_2    RE_2    RD_2    QE_2    QD_2    RL_2    RH_2    QL_2    QH_2   
    RA_3    RW_3    QA_3    QW_3    RC_3    RB_3    QC_3    QB_3    RE_3    RD_3    QE_3    QD_3    RL_3    RH_3    QL_3    QH_3   
    _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _       _       _       _       _       _       _       _       _      
    RA_P    RW_P    QA_P    QW_P    RC_P    RB_P    QC_P    QB_P    RE_P    RD_P    QE_P    QD_P    RL_P    RH_P    QL_P    QH_P   
    A       W       QA      QW      C       B       QC      QB      E       D       QE      QD      L       H       QL      QH     
    IXL     IXH     QIXL    QIXH    IYL     IYH     QIYL    QIYH    IZL     IZH     QIZL    QIZH    SPL     SPH     QSPL    QSPH   
];

attach variables [ xw7 yw7 ] [
    RWA_0   QWA_0   RBC_0   QBC_0   RDE_0   QDE_0   RHL_0   QHL_0  
    RWA_1   QWA_1   RBC_1   QBC_1   RDE_1   QDE_1   RHL_1   QHL_1  
    RWA_2   QWA_2   RBC_2   QBC_2   RDE_2   QDE_2   RHL_2   QHL_2  
    RWA_3   QWA_3   RBC_3   QBC_3   RDE_3   QDE_3   RHL_3   QHL_3  
    _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _      
    _       _       _       _       _       _       _       _      
    RWA_P   QWA_P   RBC_P   QBC_P   RDE_P   QDE_P   RHL_P   QHL_P  
    WA      QWA     BC      QBC     DE      QDE     HL      QHL    
    IX      QIX     IY      QIY     IZ      QIZ     SP      QSP    
];

attach variables [ xl6 ] [
    XWA_0   XBC_0   XDE_0   XHL_0  
    XWA_1   XBC_1   XDE_1   XHL_1  
    XWA_2   XBC_2   XDE_2   XHL_2  
    XWA_3   XBC_3   XDE_3   XHL_3  
    _       _       _       _      
    _       _       _       _      
    _       _       _       _      
    _       _       _       _      
    _       _       _       _      
    _       _       _       _      
    _       _       _       _      
    _       _       _       _      
    _       _       _       _      
    XWA_P   XBC_P   XDE_P   XHL_P  
    XWA     XBC     XDE     XHL    
    XIX     XIY     XIZ     XSP    
];


# ---------------------------------------------------------------------------------------------
# Register codes (extension byte "r"). Bank registers 0..3 (codes 00H-3FH) and the previous bank
# (D0H-DFH) live in the current-bank registers while their bank is the current one (RFP), and in
# the XWA_n... storage otherwise: these codes are resolved at run time against RFP.
# ---------------------------------------------------------------------------------------------

xrB: xb8 is x_hi<4 & xb8 & x_hi & x_lo {
    local cur:1 = (x_hi == $(RFP));
    local off:1 = x_lo + (1 - cur) * (0x50 + x_hi * 0x10);
    export *[register]:1 off;
}
xrB: xb8 is x_hi=0xd & xb8 & x_lo {
    local p:1 = ($(RFP) - 1) & 3;
    local off:1 = x_lo + 0x50 + p * 0x10;
    export *[register]:1 off;
}
xrB: xb8 is x_hi>=0xe & xb8 { export xb8; }

xrW: xw7 is x_hi<4 & x_0=0 & xw7 & x_hi & x_lo {
    local cur:1 = (x_hi == $(RFP));
    local off:1 = x_lo + (1 - cur) * (0x50 + x_hi * 0x10);
    export *[register]:2 off;
}
xrW: xw7 is x_hi=0xd & x_0=0 & xw7 & x_lo {
    local p:1 = ($(RFP) - 1) & 3;
    local off:1 = x_lo + 0x50 + p * 0x10;
    export *[register]:2 off;
}
xrW: xw7 is x_hi>=0xe & x_0=0 & xw7 { export xw7; }

# long register named by the upper six bits (the low two bits are an addressing-mode field)
xrLm: xl6 is x_hi<4 & xl6 & x_hi & x_lsub {
    local cur:1 = (x_hi == $(RFP));
    local off:1 = x_lsub * 4 + (1 - cur) * (0x50 + x_hi * 0x10);
    export *[register]:4 off;
}
xrLm: xl6 is x_hi=0xd & xl6 & x_lsub {
    local p:1 = ($(RFP) - 1) & 3;
    local off:1 = x_lsub * 4 + 0x50 + p * 0x10;
    export *[register]:4 off;
}
xrLm: xl6 is x_hi>=0xe & xl6 { export xl6; }
xrL: xrLm is x_01=0 & xrLm { export xrLm; }

# first-byte register operand "r": C8+zz+r (current bank) or C7+zz followed by a register code.
# SLEIGH cannot constrain the operation byte after a variable-length operand, so every prefix
# subtable exists once per length (rB1 = 1 byte, rB2 = 2 bytes, ...) and the instruction
# constructors are repeated for each length.
rB1: R8   is op_hi=0xc & op_3=1 & R8  { export R8; }
rB2: xrB  is op=0xc7 ; xrB            { export xrB; }
rW1: R16  is op_hi=0xd & op_3=1 & R16 { export R16; }
rW2: xrW  is op=0xd7 ; xrW            { export xrW; }
rL1: R32  is op_hi=0xe & op_3=1 & R32 { export R32; }
rL2: xrL  is op=0xe7 ; xrL            { export xrL; }

# "rr" of MUL/DIV rr,#: the register twice the operand size whose low half is r
mrB1: RRb is op_hi=0xc & op_3=1 & op_0=1 & RRb { export RRb; }
mrB2: xrW is op=0xc7 ; xrW                      { export xrW; }
mrW1: R32 is op_hi=0xd & op_3=1 & R32           { export R32; }
mrW2: xrL is op=0xd7 ; xrL                      { export xrL; }

# ---------------------------------------------------------------------------------------------
# Memory operands ("mem", manual: memory addressing mode specify code); eaN exports the address
# and is N bytes long. The sign-bit splits keep every pattern N bytes wide.
# ---------------------------------------------------------------------------------------------

d8d: "+"^xs is xs & x_7=0 { export *[const]:4 xs; }
d8d: "-"^nd is xs & x_7=1 [ nd = -xs; ] { export *[const]:4 xs; }
d16d: "+"^v  is xa ; xbs & x_7=0 [ v = (xbs << 8) | xa; ] { export *[const]:4 v; }
d16d: "-"^nd is xa ; xbs & x_7=1 [ nd = -((xbs << 8) | xa); ] { local v:4 = -nd; export v; }
i16e: v is xa ; xb [ v = (xb << 8) | xa; ] { export *[const]:4 v; }
i24e: v is xa ; xb ; xc [ v = (xc << 16) | (xb << 8) | xa; ] { export *[const]:4 v; }

smB_R: "("^R32^")" is op_7=1 & op_sz=0 & op_6=0 & op_3=0 & R32 { local a:4 = R32; export *:1 a; }
smB_Rd8: "("^R32^d8d^")" is op_7=1 & op_sz=0 & op_6=0 & op_3=1 & R32 ; d8d { local a:4 = R32 + d8d; export *:1 a; }
smB_n: "("^xa^")" is op_7=1 & op_sz=0 & op_6=1 & op_lo=0 ; xa { local a:4 = xa; export *:1 a; }
smB_nn: "("^i16e^")" is op_7=1 & op_sz=0 & op_6=1 & op_lo=1 ; i16e { local a:4 = i16e; export *:1 a; }
smB_nnn: "("^i24e^")" is op_7=1 & op_sz=0 & op_6=1 & op_lo=2 ; i24e { local a:4 = i24e; export *:1 a; }
smB_r: "("^xrLm^")" is op_7=1 & op_sz=0 & op_6=1 & op_lo=3 ; x_01=0 & xrLm { local a:4 = xrLm; export *:1 a; }
smB_rd16: "("^xrLm^d16d^")" is op_7=1 & op_sz=0 & op_6=1 & op_lo=3 ; x_01=1 & xrLm ; d16d { local a:4 = xrLm + d16d; export *:1 a; }
smB_rr8: "("^xrL^"+"^xrB^")" is op_7=1 & op_sz=0 & op_6=1 & op_lo=3 ; x=0x03 ; xrL ; xrB { local a:4 = xrL + sext(xrB); export *:1 a; }
smB_rr16: "("^xrL^"+"^xrW^")" is op_7=1 & op_sz=0 & op_6=1 & op_lo=3 ; x=0x07 ; xrL ; xrW { local a:4 = xrL + sext(xrW); export *:1 a; }
smB_dec: "("^"-"^xrLm^":"^stp^")" is op_7=1 & op_sz=0 & op_6=1 & op_lo=4 ; x_01<3 & x_01 & xrLm [ stp = 1 << x_01; ] { xrLm = xrLm - stp; local a:4 = xrLm; export *:1 a; }
smB_inc: "("^xrLm^"+:"^stp^")" is op_7=1 & op_sz=0 & op_6=1 & op_lo=5 ; x_01<3 & x_01 & xrLm [ stp = 1 << x_01; ] { local a:4 = xrLm; xrLm = xrLm + stp; export *:1 a; }

smW_R: "("^R32^")" is op_7=1 & op_sz=1 & op_6=0 & op_3=0 & R32 { local a:4 = R32; export *:2 a; }
smW_Rd8: "("^R32^d8d^")" is op_7=1 & op_sz=1 & op_6=0 & op_3=1 & R32 ; d8d { local a:4 = R32 + d8d; export *:2 a; }
smW_n: "("^xa^")" is op_7=1 & op_sz=1 & op_6=1 & op_lo=0 ; xa { local a:4 = xa; export *:2 a; }
smW_nn: "("^i16e^")" is op_7=1 & op_sz=1 & op_6=1 & op_lo=1 ; i16e { local a:4 = i16e; export *:2 a; }
smW_nnn: "("^i24e^")" is op_7=1 & op_sz=1 & op_6=1 & op_lo=2 ; i24e { local a:4 = i24e; export *:2 a; }
smW_r: "("^xrLm^")" is op_7=1 & op_sz=1 & op_6=1 & op_lo=3 ; x_01=0 & xrLm { local a:4 = xrLm; export *:2 a; }
smW_rd16: "("^xrLm^d16d^")" is op_7=1 & op_sz=1 & op_6=1 & op_lo=3 ; x_01=1 & xrLm ; d16d { local a:4 = xrLm + d16d; export *:2 a; }
smW_rr8: "("^xrL^"+"^xrB^")" is op_7=1 & op_sz=1 & op_6=1 & op_lo=3 ; x=0x03 ; xrL ; xrB { local a:4 = xrL + sext(xrB); export *:2 a; }
smW_rr16: "("^xrL^"+"^xrW^")" is op_7=1 & op_sz=1 & op_6=1 & op_lo=3 ; x=0x07 ; xrL ; xrW { local a:4 = xrL + sext(xrW); export *:2 a; }
smW_dec: "("^"-"^xrLm^":"^stp^")" is op_7=1 & op_sz=1 & op_6=1 & op_lo=4 ; x_01<3 & x_01 & xrLm [ stp = 1 << x_01; ] { xrLm = xrLm - stp; local a:4 = xrLm; export *:2 a; }
smW_inc: "("^xrLm^"+:"^stp^")" is op_7=1 & op_sz=1 & op_6=1 & op_lo=5 ; x_01<3 & x_01 & xrLm [ stp = 1 << x_01; ] { local a:4 = xrLm; xrLm = xrLm + stp; export *:2 a; }

smL_R: "("^R32^")" is op_7=1 & op_sz=2 & op_6=0 & op_3=0 & R32 { local a:4 = R32; export *:4 a; }
smL_Rd8: "("^R32^d8d^")" is op_7=1 & op_sz=2 & op_6=0 & op_3=1 & R32 ; d8d { local a:4 = R32 + d8d; export *:4 a; }
smL_n: "("^xa^")" is op_7=1 & op_sz=2 & op_6=1 & op_lo=0 ; xa { local a:4 = xa; export *:4 a; }
smL_nn: "("^i16e^")" is op_7=1 & op_sz=2 & op_6=1 & op_lo=1 ; i16e { local a:4 = i16e; export *:4 a; }
smL_nnn: "("^i24e^")" is op_7=1 & op_sz=2 & op_6=1 & op_lo=2 ; i24e { local a:4 = i24e; export *:4 a; }
smL_r: "("^xrLm^")" is op_7=1 & op_sz=2 & op_6=1 & op_lo=3 ; x_01=0 & xrLm { local a:4 = xrLm; export *:4 a; }
smL_rd16: "("^xrLm^d16d^")" is op_7=1 & op_sz=2 & op_6=1 & op_lo=3 ; x_01=1 & xrLm ; d16d { local a:4 = xrLm + d16d; export *:4 a; }
smL_rr8: "("^xrL^"+"^xrB^")" is op_7=1 & op_sz=2 & op_6=1 & op_lo=3 ; x=0x03 ; xrL ; xrB { local a:4 = xrL + sext(xrB); export *:4 a; }
smL_rr16: "("^xrL^"+"^xrW^")" is op_7=1 & op_sz=2 & op_6=1 & op_lo=3 ; x=0x07 ; xrL ; xrW { local a:4 = xrL + sext(xrW); export *:4 a; }
smL_dec: "("^"-"^xrLm^":"^stp^")" is op_7=1 & op_sz=2 & op_6=1 & op_lo=4 ; x_01<3 & x_01 & xrLm [ stp = 1 << x_01; ] { xrLm = xrLm - stp; local a:4 = xrLm; export *:4 a; }
smL_inc: "("^xrLm^"+:"^stp^")" is op_7=1 & op_sz=2 & op_6=1 & op_lo=5 ; x_01<3 & x_01 & xrLm [ stp = 1 << x_01; ] { local a:4 = xrLm; xrLm = xrLm + stp; export *:4 a; }

dmA_R: R32 is op_7=1 & op_sz=3 & op_6=0 & op_3=0 & R32 { local a:4 = R32; export a; }
dmA_Rd8: R32^d8d is op_7=1 & op_sz=3 & op_6=0 & op_3=1 & R32 ; d8d { local a:4 = R32 + d8d; export a; }
dmA_n: xa is op_7=1 & op_sz=3 & op_6=1 & op_lo=0 ; xa { local a:4 = xa; export a; }
dmA_nn: i16e is op_7=1 & op_sz=3 & op_6=1 & op_lo=1 ; i16e { local a:4 = i16e; export a; }
dmA_nnn: i24e is op_7=1 & op_sz=3 & op_6=1 & op_lo=2 ; i24e { local a:4 = i24e; export a; }
dmA_r: xrLm is op_7=1 & op_sz=3 & op_6=1 & op_lo=3 ; x_01=0 & xrLm { local a:4 = xrLm; export a; }
dmA_rd16: xrLm^d16d is op_7=1 & op_sz=3 & op_6=1 & op_lo=3 ; x_01=1 & xrLm ; d16d { local a:4 = xrLm + d16d; export a; }
dmA_rr8: xrL^"+"^xrB is op_7=1 & op_sz=3 & op_6=1 & op_lo=3 ; x=0x03 ; xrL ; xrB { local a:4 = xrL + sext(xrB); export a; }
dmA_rr16: xrL^"+"^xrW is op_7=1 & op_sz=3 & op_6=1 & op_lo=3 ; x=0x07 ; xrL ; xrW { local a:4 = xrL + sext(xrW); export a; }
dmA_dec: "-"^xrLm^":"^stp is op_7=1 & op_sz=3 & op_6=1 & op_lo=4 ; x_01<3 & x_01 & xrLm [ stp = 1 << x_01; ] { xrLm = xrLm - stp; local a:4 = xrLm; export a; }
dmA_inc: xrLm^"+:"^stp is op_7=1 & op_sz=3 & op_6=1 & op_lo=5 ; x_01<3 & x_01 & xrLm [ stp = 1 << x_01; ] { local a:4 = xrLm; xrLm = xrLm + stp; export a; }


# absolute operands that follow the operation byte
n8a:  imm8  is imm8  { export *[const]:4 imm8; }
n16a: imm16 is imm16 { export *[const]:4 imm16; }

rel8:  reloc is simm8  [ reloc = inst_next + simm8; ]  { export *:4 reloc; }
rel16: reloc is simm16 [ reloc = inst_next + simm16; ] { export *:4 reloc; }

cc: "F"   is op_cc=0x0 { c:1 = 0; export c; }
cc: "LT"  is op_cc=0x1 { c:1 = ($(S_flag) ^ $(V_flag)); export c; }
cc: "LE"  is op_cc=0x2 { c:1 = ($(Z_flag) | ($(S_flag) ^ $(V_flag))); export c; }
cc: "ULE" is op_cc=0x3 { c:1 = ($(C_flag) | $(Z_flag)); export c; }
cc: "OV"  is op_cc=0x4 { c:1 = $(V_flag); export c; }
cc: "MI"  is op_cc=0x5 { c:1 = $(S_flag); export c; }
cc: "Z"   is op_cc=0x6 { c:1 = $(Z_flag); export c; }
cc: "C"   is op_cc=0x7 { c:1 = $(C_flag); export c; }
cc: "T"   is op_cc=0x8 { c:1 = 1; export c; }
cc: "GE"  is op_cc=0x9 { c:1 = ($(S_flag) ^ $(V_flag)) == 0; export c; }
cc: "GT"  is op_cc=0xa { c:1 = ($(Z_flag) | ($(S_flag) ^ $(V_flag))) == 0; export c; }
cc: "UGT" is op_cc=0xb { c:1 = ($(C_flag) | $(Z_flag)) == 0; export c; }
cc: "NOV" is op_cc=0xc { c:1 = $(V_flag) == 0; export c; }
cc: "PL"  is op_cc=0xd { c:1 = $(S_flag) == 0; export c; }
cc: "NZ"  is op_cc=0xe { c:1 = $(Z_flag) == 0; export c; }
cc: "NC"  is op_cc=0xf { c:1 = $(C_flag) == 0; export c; }

# control registers (LDC)
crB: "DMAM0" is x=0x22 { export DMAM_0; }
crB: "DMAM1" is x=0x26 { export DMAM_1; }
crB: "DMAM2" is x=0x2a { export DMAM_2; }
crB: "DMAM3" is x=0x2e { export DMAM_3; }
crW: "DMAC0" is x=0x20 { export DMAC_0; }
crW: "DMAC1" is x=0x24 { export DMAC_1; }
crW: "DMAC2" is x=0x28 { export DMAC_2; }
crW: "DMAC3" is x=0x2c { export DMAC_3; }
crW: "INTNEST" is x=0x3c { export INTNEST; }
crL: "DMAS0" is x=0x00 { export DMAS_0; }
crL: "DMAS1" is x=0x04 { export DMAS_1; }
crL: "DMAS2" is x=0x08 { export DMAS_2; }
crL: "DMAS3" is x=0x0c { export DMAS_3; }
crL: "DMAD0" is x=0x10 { export DMAD_0; }
crL: "DMAD1" is x=0x14 { export DMAD_1; }
crL: "DMAD2" is x=0x18 { export DMAD_2; }
crL: "DMAD3" is x=0x1c { export DMAD_3; }

# #3 of INC/DEC: object code 0 means 8
n3: "8"  is imm3=0 { export 8:1; }
n3: imm3 is imm3   { export *[const]:1 imm3; }
# #4 of shifts and rotates: 0 means 16
n4: "16" is imm8_hi=0 & imm4=0 { export 16:1; }
n4: imm4 is imm8_hi=0 & imm4   { export *[const]:1 imm4; }
# bit number #4 (bit operations on registers; 0..7 for a byte register)
bn3: imm3d is d8_37=0 & imm3d { export *[const]:1 imm3d; }
b4: imm4 is imm8_hi=0 & imm4 { export *[const]:1 imm4; }

# ---------------------------------------------------------------------------------------------
# Operation macros (manual: Appendix B Instruction Lists, flag columns SZHVNC)
# ---------------------------------------------------------------------------------------------

macro resSZ(r) {
    $(S_flag) = r s< 0;
    $(Z_flag) = r == 0;
}
macro parityV(r) {
    local pc:1 = popcount(r);
    $(V_flag) = (pc & 1) == 0;
}
# ADD/ADC: S Z H V, N=0, C
macro addf(a, b, cin, dst) {
    local c = a;
    c = zext($(C_flag) & cin);
    local r = a + b + c;
    $(H_flag) = ((a ^ b ^ r) & 0x10) != 0;
    $(V_flag) = ((a ^ r) & (b ^ r)) s< 0;
    $(C_flag) = carry(a, b) || carry(a + b, c);
    $(N_flag) = 0;
    resSZ(r);
    dst = r;
}
# SUB/SBC/CP/NEG: S Z H V, N=1, C (borrow)
macro subf(a, b, cin, dst) {
    local c = a;
    c = zext($(C_flag) & cin);
    local r = a - b - c;
    $(H_flag) = ((a ^ b ^ r) & 0x10) != 0;
    $(V_flag) = ((a ^ b) & (a ^ r)) s< 0;
    $(C_flag) = (a < b) || ((a - b) < c);
    $(N_flag) = 1;
    resSZ(r);
    dst = r;
}
# INC/DEC #3 on a byte register or on memory: C unchanged
macro incf(a, n) {
    local r = a + n;
    $(H_flag) = ((a ^ n ^ r) & 0x10) != 0;
    $(V_flag) = ((a ^ r) & (n ^ r)) s< 0;
    $(N_flag) = 0;
    resSZ(r);
    a = r;
}
macro decf(a, n) {
    local r = a - n;
    $(H_flag) = ((a ^ n ^ r) & 0x10) != 0;
    $(V_flag) = ((a ^ n) & (a ^ r)) s< 0;
    $(N_flag) = 1;
    resSZ(r);
    a = r;
}
# AND: H=1; OR/XOR: H=0; V=parity, N=0, C=0
macro logf(r, h) {
    resSZ(r);
    parityV(r);
    local hh:1 = h;
    $(H_flag) = hh;
    $(N_flag) = 0;
    $(C_flag) = 0;
}

# shifts and rotates: S Z, H=0, V=parity, N=0, C. n = count (1..16), w = operand width in bits
macro shf(r) {
    resSZ(r);
    parityV(r);
    $(H_flag) = 0;
    $(N_flag) = 0;
}
macro rlc_(d, n, w) {
    local m = n % w;
    d = (d << m) | (d >> (w - m));
    $(C_flag) = (d & 1) != 0;
    shf(d);
}
macro rrc_(d, n, w) {
    local m = n % w;
    d = (d >> m) | (d << (w - m));
    $(C_flag) = d s< 0;
    shf(d);
}
macro rl_(d, n, w) {
    local m:1 = n % (w + 1);
    if (m == 0) goto <none>;
    local cy = d;
    cy = zext($(C_flag));
    local o = d;
    d = (o << m) | (cy << (m - 1)) | (o >> (w + 1 - m));
    $(C_flag) = ((o >> (w - m)) & 1) != 0;
<none>
    shf(d);
}
macro rr_(d, n, w) {
    local m:1 = n % (w + 1);
    if (m == 0) goto <none>;
    local cy = d;
    cy = zext($(C_flag));
    local o = d;
    d = (o >> m) | (cy << (w - m)) | (o << (w + 1 - m));
    $(C_flag) = ((o >> (m - 1)) & 1) != 0;
<none>
    shf(d);
}
macro sla_(d, n, w) {
    $(C_flag) = 0;
    if (n > w) goto <big>;
    $(C_flag) = ((d >> (w - n)) & 1) != 0;
<big>
    d = d << n;
    shf(d);
}
macro sra_(d, n) {
    $(C_flag) = ((d s>> (n - 1)) & 1) != 0;
    d = d s>> n;
    shf(d);
}
macro srl_(d, n) {
    $(C_flag) = ((d >> (n - 1)) & 1) != 0;
    d = d >> n;
    shf(d);
}

# MUL/MULS rr,src: rr <- rr<low half> x src
macro mulu8(rr, s) {
    rr = zext(rr:1) * zext(s);
}
macro mulu16(rr, s) {
    rr = zext(rr:2) * zext(s);
}
macro muls8(rr, s) {
    rr = sext(rr:1) * sext(s);
}
macro muls16(rr, s) {
    rr = sext(rr:2) * sext(s);
}
# DIV/DIVS rr,src: rr<low half> <- quotient, rr<high half> <- remainder; V = divide by 0 or overflow
macro divu8(rr, s) {
    $(V_flag) = 1;
    if (s == 0) goto <done>;
    local q:2 = rr / zext(s);
    local r:2 = rr % zext(s);
    $(V_flag) = q > 0xff;
    rr = (r << 8) | (q & 0xff);
<done>
}
macro divu16(rr, s) {
    $(V_flag) = 1;
    if (s == 0) goto <done>;
    local q:4 = rr / zext(s);
    local r:4 = rr % zext(s);
    $(V_flag) = q > 0xffff;
    rr = (r << 16) | (q & 0xffff);
<done>
}
macro divs8(rr, s) {
    $(V_flag) = 1;
    if (s == 0) goto <done>;
    local q:2 = rr s/ sext(s);
    local r:2 = rr s% sext(s);
    $(V_flag) = (q s> 0x7f) || (q s< -0x80);
    rr = (r << 8) | (q & 0xff);
<done>
}
macro divs16(rr, s) {
    $(V_flag) = 1;
    if (s == 0) goto <done>;
    local q:4 = rr s/ sext(s);
    local r:4 = rr s% sext(s);
    $(V_flag) = (q s> 0x7fff) || (q s< -0x8000);
    rr = (r << 16) | (q & 0xffff);
<done>
}

# stack (XSP, maximum mode: PC is pushed as 32 bits)
macro push8(v)  { XSP = XSP - 1; *:1 XSP = v; }
macro push16(v) { XSP = XSP - 2; *:2 XSP = v; }
macro push32(v) { XSP = XSP - 4; *:4 XSP = v; }
macro pop8(v)   { v = *:1 XSP; XSP = XSP + 1; }
macro pop16(v)  { v = *:2 XSP; XSP = XSP + 2; }
macro pop32(v)  { v = *:4 XSP; XSP = XSP + 4; }

# register banks: XWA..XHL hold the current bank; on a bank change they are stored to the old bank
# and loaded from the new one (RFP2 is fixed at 0 in maximum mode)
macro store_bank(b) {
    if (b != 0) goto <b1>;
    XWA_0 = XWA; XBC_0 = XBC; XDE_0 = XDE; XHL_0 = XHL; goto <end>;
<b1>
    if (b != 1) goto <b2>;
    XWA_1 = XWA; XBC_1 = XBC; XDE_1 = XDE; XHL_1 = XHL; goto <end>;
<b2>
    if (b != 2) goto <b3>;
    XWA_2 = XWA; XBC_2 = XBC; XDE_2 = XDE; XHL_2 = XHL; goto <end>;
<b3>
    XWA_3 = XWA; XBC_3 = XBC; XDE_3 = XDE; XHL_3 = XHL;
<end>
}
macro load_bank(b) {
    if (b != 0) goto <b1>;
    XWA = XWA_0; XBC = XBC_0; XDE = XDE_0; XHL = XHL_0; goto <end>;
<b1>
    if (b != 1) goto <b2>;
    XWA = XWA_1; XBC = XBC_1; XDE = XDE_1; XHL = XHL_1; goto <end>;
<b2>
    if (b != 2) goto <b3>;
    XWA = XWA_2; XBC = XBC_2; XDE = XDE_2; XHL = XHL_2; goto <end>;
<b3>
    XWA = XWA_3; XBC = XBC_3; XDE = XDE_3; XHL = XHL_3;
<end>
}
macro switch_bank(old) {
    $(RFP) = $(RFP) & 3;
    if (old == $(RFP)) goto <same>;
    store_bank(old);
    load_bank($(RFP));
<same>
}

# ---------------------------------------------------------------- 1-byte op codes
:nop        is op=0x00 { }
# NORMAL and MAX exist on the TLCS-900 core; the 900/H always runs in system and maximum mode
:normal     is op=0x01 { $(SYSM) = 0; }
:push SR    is op=0x02 & SR { push16(SR); }
:pop SR     is op=0x03 & SR { local old:1 = $(RFP); pop16(SR); switch_bank(old); }
:max        is op=0x04 { $(MAX) = 1; }
:halt       is op=0x05 { halt(); }
:ei imm3d   is op=0x06 ; d8_37=0 & imm3d { $(IFF) = imm3d; }
:reti       is op=0x07 { local old:1 = $(RFP); pop16(SR); switch_bank(old); local t:4 = 0; pop32(t); INTNEST = INTNEST - 1; return [t]; }
:ld (n8a),imm8    is op=0x08 ; n8a ; imm8  { *:1 n8a = imm8; }
:push imm8        is op=0x09 ; imm8  { local v:1 = imm8; push8(v); }
:ldw (n8a),imm16  is op=0x0a ; n8a ; imm16 { *:2 n8a = imm16; }
:pushw imm16      is op=0x0b ; imm16 { local v:2 = imm16; push16(v); }
:incf       is op=0x0c { local old:1 = $(RFP); $(RFP) = $(RFP) + 1; switch_bank(old); }
:decf       is op=0x0d { local old:1 = $(RFP); $(RFP) = $(RFP) - 1; switch_bank(old); }
:ret        is op=0x0e { local t:4 = 0; pop32(t); return [t]; }
:retd simm16 is op=0x0f ; simm16 { local t:4 = 0; pop32(t); XSP = XSP + simm16; return [t]; }
:rcf        is op=0x10 { $(H_flag) = 0; $(N_flag) = 0; $(C_flag) = 0; }
:scf        is op=0x11 { $(H_flag) = 0; $(N_flag) = 0; $(C_flag) = 1; }
# CCF/ZCF leave H undefined (manual: X); it is left unchanged here
:ccf        is op=0x12 { $(N_flag) = 0; $(C_flag) = !$(C_flag); }
:zcf        is op=0x13 { $(N_flag) = 0; $(C_flag) = !$(Z_flag); }
:push A     is op=0x14 & A { push8(A); }
:pop A      is op=0x15 & A { pop8(A); }
:ex F,"F'" is op=0x16 & F { local t:1 = F; F = F_I; F_I = t; }
:ldf imm3d  is op=0x17 ; d8_37=0 & imm3d { local old:1 = $(RFP); $(RFP) = imm3d; switch_bank(old); }
:push F     is op=0x18 & F { push8(F); }
:pop F      is op=0x19 & F { pop8(F); }
a16: imm16 is imm16 { export *:4 imm16; }
a24: imm24 is imm24 { export *:4 imm24; }
:jp a16     is op=0x1a ; a16 { goto a16; }
:jp a24     is op=0x1b ; a24 { goto a24; }
:call a16   is op=0x1c ; a16 { push32(&:4 inst_next); call a16; }
:call a24   is op=0x1d ; a24 { push32(&:4 inst_next); call a24; }
:calr rel16 is op=0x1e ; rel16 { push32(&:4 inst_next); call rel16; }
:ld R8,imm8    is op_hi=0x2 & op_3=0 & R8  ; imm8  { R8 = imm8; }
:push R16      is op_hi=0x2 & op_3=1 & R16 { push16(R16); }
:ld R16,imm16  is op_hi=0x3 & op_3=0 & R16 ; imm16 { R16 = imm16; }
:push R32      is op_hi=0x3 & op_3=1 & R32 { push32(R32); }
:ld R32,imm32  is op_hi=0x4 & op_3=0 & R32 ; imm32 { R32 = imm32; }
:pop R16       is op_hi=0x4 & op_3=1 & R16 { pop16(R16); }
:pop R32       is op_hi=0x5 & op_3=1 & R32 { pop32(R32); }
:jr cc,rel8    is op_hi=0x6 & cc ; rel8  { if (cc) goto rel8; }
:jrl cc,rel16  is op_hi=0x7 & cc ; rel16 { if (cc) goto rel16; }
z0a: is x=0 { }
z0b: is x=0 { }
z0c: is x=0 { }
:ldx (n8a),imm8 is op=0xf7 ; z0a ; n8a ; z0b ; imm8 ; z0c { *:1 n8a = imm8; }
:swi imm3      is op_hi=0xf & op_3=1 & imm3 {
    push32(&:4 inst_next); push16(SR);
    local va:4 = 0xffff00 + imm3 * 4; local h:4 = *:4 va;
    call [h];
}

# ---------------------------------------------------------------- first byte: reg (C8+zz+r, C7+zz r)
# B
:ld rB1,imm8   is rB1 ; op=0x03 ; imm8 { rB1 = imm8; }
:ld rB2,imm8   is rB2 ; op=0x03 ; imm8 { rB2 = imm8; }
:push rB1       is rB1 ; op=0x04 { push8(rB1); }
:push rB2       is rB2 ; op=0x04 { push8(rB2); }
:pop rB1        is rB1 ; op=0x05 { pop8(rB1); }
:pop rB2        is rB2 ; op=0x05 { pop8(rB2); }
:cpl rB1    is rB1 ; op=0x06 { rB1 = ~rB1; $(H_flag) = 1; $(N_flag) = 1; }
:cpl rB2    is rB2 ; op=0x06 { rB2 = ~rB2; $(H_flag) = 1; $(N_flag) = 1; }
:neg rB1    is rB1 ; op=0x07 { local z = rB1; z = 0; subf(z, rB1, 0, rB1); }
:neg rB2    is rB2 ; op=0x07 { local z = rB2; z = 0; subf(z, rB2, 0, rB2); }
:djnz rB1,rel8 is rB1 ; op=0x1c ; rel8 { rB1 = rB1 - 1; if (rB1 != 0) goto rel8; }
:djnz rB2,rel8 is rB2 ; op=0x1c ; rel8 { rB2 = rB2 - 1; if (rB2 != 0) goto rel8; }
:andcf bn3,rB1  is rB1 ; op=0x20 ; bn3 { local b:1 = ((rB1 >> bn3) & 1) != 0; $(C_flag) = $(C_flag) & b; }
:andcf bn3,rB2  is rB2 ; op=0x20 ; bn3 { local b:1 = ((rB2 >> bn3) & 1) != 0; $(C_flag) = $(C_flag) & b; }
:andcf A,rB1   is rB1 ; op=0x28 & A { local n:1 = A & 0xf; local b:1 = ((rB1 >> n) & 1) != 0; $(C_flag) = $(C_flag) & b; }
:andcf A,rB2   is rB2 ; op=0x28 & A { local n:1 = A & 0xf; local b:1 = ((rB2 >> n) & 1) != 0; $(C_flag) = $(C_flag) & b; }
:orcf bn3,rB1  is rB1 ; op=0x21 ; bn3 { local b:1 = ((rB1 >> bn3) & 1) != 0; $(C_flag) = $(C_flag) | b; }
:orcf bn3,rB2  is rB2 ; op=0x21 ; bn3 { local b:1 = ((rB2 >> bn3) & 1) != 0; $(C_flag) = $(C_flag) | b; }
:orcf A,rB1   is rB1 ; op=0x29 & A { local n:1 = A & 0xf; local b:1 = ((rB1 >> n) & 1) != 0; $(C_flag) = $(C_flag) | b; }
:orcf A,rB2   is rB2 ; op=0x29 & A { local n:1 = A & 0xf; local b:1 = ((rB2 >> n) & 1) != 0; $(C_flag) = $(C_flag) | b; }
:xorcf bn3,rB1  is rB1 ; op=0x22 ; bn3 { local b:1 = ((rB1 >> bn3) & 1) != 0; $(C_flag) = $(C_flag) ^ b; }
:xorcf bn3,rB2  is rB2 ; op=0x22 ; bn3 { local b:1 = ((rB2 >> bn3) & 1) != 0; $(C_flag) = $(C_flag) ^ b; }
:xorcf A,rB1   is rB1 ; op=0x2a & A { local n:1 = A & 0xf; local b:1 = ((rB1 >> n) & 1) != 0; $(C_flag) = $(C_flag) ^ b; }
:xorcf A,rB2   is rB2 ; op=0x2a & A { local n:1 = A & 0xf; local b:1 = ((rB2 >> n) & 1) != 0; $(C_flag) = $(C_flag) ^ b; }
:ldcf bn3,rB1  is rB1 ; op=0x23 ; bn3 { local b:1 = ((rB1 >> bn3) & 1) != 0; $(C_flag) = b; }
:ldcf bn3,rB2  is rB2 ; op=0x23 ; bn3 { local b:1 = ((rB2 >> bn3) & 1) != 0; $(C_flag) = b; }
:ldcf A,rB1   is rB1 ; op=0x2b & A { local n:1 = A & 0xf; local b:1 = ((rB1 >> n) & 1) != 0; $(C_flag) = b; }
:ldcf A,rB2   is rB2 ; op=0x2b & A { local n:1 = A & 0xf; local b:1 = ((rB2 >> n) & 1) != 0; $(C_flag) = b; }
:stcf bn3,rB1  is rB1 ; op=0x24 ; bn3 { local m = rB1; m = 1 << bn3; rB1 = (rB1 & ~m) | (m * zext($(C_flag))); }
:stcf bn3,rB2  is rB2 ; op=0x24 ; bn3 { local m = rB2; m = 1 << bn3; rB2 = (rB2 & ~m) | (m * zext($(C_flag))); }
:stcf A,rB1   is rB1 ; op=0x2c & A { local n:1 = A & 0xf; local m = rB1; m = 1 << n; rB1 = (rB1 & ~m) | (m * zext($(C_flag))); }
:stcf A,rB2   is rB2 ; op=0x2c & A { local n:1 = A & 0xf; local m = rB2; m = 1 << n; rB2 = (rB2 & ~m) | (m * zext($(C_flag))); }
:res bn3,rB1   is rB1 ; op=0x30 ; bn3 { local m = rB1; m = 1 << bn3; rB1 = rB1 & ~m; }
:res bn3,rB2   is rB2 ; op=0x30 ; bn3 { local m = rB2; m = 1 << bn3; rB2 = rB2 & ~m; }
:set bn3,rB1   is rB1 ; op=0x31 ; bn3 { local m = rB1; m = 1 << bn3; rB1 = rB1 | m; }
:set bn3,rB2   is rB2 ; op=0x31 ; bn3 { local m = rB2; m = 1 << bn3; rB2 = rB2 | m; }
:chg bn3,rB1   is rB1 ; op=0x32 ; bn3 { local m = rB1; m = 1 << bn3; rB1 = rB1 ^ m; }
:chg bn3,rB2   is rB2 ; op=0x32 ; bn3 { local m = rB2; m = 1 << bn3; rB2 = rB2 ^ m; }
# BIT/TSET: S and V undefined (manual: X), left unchanged
:bit bn3,rB1   is rB1 ; op=0x33 ; bn3 { $(Z_flag) = ((rB1 >> bn3) & 1) == 0; $(H_flag) = 1; $(N_flag) = 0; }
:bit bn3,rB2   is rB2 ; op=0x33 ; bn3 { $(Z_flag) = ((rB2 >> bn3) & 1) == 0; $(H_flag) = 1; $(N_flag) = 0; }
:tset bn3,rB1  is rB1 ; op=0x34 ; bn3 { $(Z_flag) = ((rB1 >> bn3) & 1) == 0; $(H_flag) = 1; $(N_flag) = 0; local m = rB1; m = 1 << bn3; rB1 = rB1 | m; }
:tset bn3,rB2  is rB2 ; op=0x34 ; bn3 { $(Z_flag) = ((rB2 >> bn3) & 1) == 0; $(H_flag) = 1; $(N_flag) = 0; local m = rB2; m = 1 << bn3; rB2 = rB2 | m; }
:scc cc,rB1   is rB1 ; op_hi=0x7 & cc { rB1 = zext(cc); }
:scc cc,rB2   is rB2 ; op_hi=0x7 & cc { rB2 = zext(cc); }
:ex R8,rB1   is rB1 ; op_hi=0xb & op_3=1 & R8 { local t = rB1; rB1 = R8; R8 = t; }
:ex R8,rB2   is rB2 ; op_hi=0xb & op_3=1 & R8 { local t = rB2; rB2 = R8; R8 = t; }
:cp rB1,imm3  is rB1 ; op_hi=0xd & op_3=1 & imm3 { local t = rB1; local k = rB1; k = imm3; subf(rB1, k, 0, t); }
:cp rB2,imm3  is rB2 ; op_hi=0xd & op_3=1 & imm3 { local t = rB2; local k = rB2; k = imm3; subf(rB2, k, 0, t); }
:daa rB1      is rB1 ; op=0x10 {
    local a:1 = rB1; local d:1 = 0; local cy:1 = $(C_flag);
    if (($(H_flag) == 0) && ((a & 0xf) <= 9)) goto <lo>;
    d = 0x06;
<lo>
    if (($(C_flag) == 0) && (a <= 0x99)) goto <hi>;
    d = d | 0x60; cy = 1;
<hi>
    local r:1 = a + d;
    if ($(N_flag) == 0) goto <add>;
    r = a - d;
<add>
    $(H_flag) = ((a ^ r) & 0x10) != 0;
    $(C_flag) = cy; resSZ(r); parityV(r); rB1 = r;
}
:daa rB2      is rB2 ; op=0x10 {
    local a:1 = rB2; local d:1 = 0; local cy:1 = $(C_flag);
    if (($(H_flag) == 0) && ((a & 0xf) <= 9)) goto <lo>;
    d = 0x06;
<lo>
    if (($(C_flag) == 0) && (a <= 0x99)) goto <hi>;
    d = d | 0x60; cy = 1;
<hi>
    local r:1 = a + d;
    if ($(N_flag) == 0) goto <add>;
    r = a - d;
<add>
    $(H_flag) = ((a ^ r) & 0x10) != 0;
    $(C_flag) = cy; resSZ(r); parityV(r); rB2 = r;
}
:mul mrB1,imm8  is mrB1 ; op=0x08 ; imm8 { local s:1 = imm8; mulu8(mrB1, s); }
:mul mrB2,imm8  is mrB2 ; op=0x08 ; imm8 { local s:1 = imm8; mulu8(mrB2, s); }
:muls mrB1,imm8 is mrB1 ; op=0x09 ; imm8 { local s:1 = imm8; muls8(mrB1, s); }
:muls mrB2,imm8 is mrB2 ; op=0x09 ; imm8 { local s:1 = imm8; muls8(mrB2, s); }
