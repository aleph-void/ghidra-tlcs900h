# block transfer and search (prefix 80+zz+R / 83+zz, 85+zz)
:ldi (XDE^"+"),(XHL^"+") is op=0x83 & XDE & XHL ; op=0x10 {
    *:1 XDE = *:1 XHL; XDE = XDE + 1; XHL = XHL + 1; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
}
:ldir (XDE^"+"),(XHL^"+") is op=0x83 & XDE & XHL ; op=0x11 {
    *:1 XDE = *:1 XHL; XDE = XDE + 1; XHL = XHL + 1; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
    if (BC != 0) goto inst_start;
}
:ldd (XDE^"-"),(XHL^"-") is op=0x83 & XDE & XHL ; op=0x12 {
    *:1 XDE = *:1 XHL; XDE = XDE - 1; XHL = XHL - 1; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
}
:lddr (XDE^"-"),(XHL^"-") is op=0x83 & XDE & XHL ; op=0x13 {
    *:1 XDE = *:1 XHL; XDE = XDE - 1; XHL = XHL - 1; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
    if (BC != 0) goto inst_start;
}
:ldi (XIX^"+"),(XIY^"+") is op=0x85 & XIX & XIY ; op=0x10 {
    *:1 XIX = *:1 XIY; XIX = XIX + 1; XIY = XIY + 1; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
}
:ldir (XIX^"+"),(XIY^"+") is op=0x85 & XIX & XIY ; op=0x11 {
    *:1 XIX = *:1 XIY; XIX = XIX + 1; XIY = XIY + 1; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
    if (BC != 0) goto inst_start;
}
:ldd (XIX^"-"),(XIY^"-") is op=0x85 & XIX & XIY ; op=0x12 {
    *:1 XIX = *:1 XIY; XIX = XIX - 1; XIY = XIY - 1; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
}
:lddr (XIX^"-"),(XIY^"-") is op=0x85 & XIX & XIY ; op=0x13 {
    *:1 XIX = *:1 XIY; XIX = XIX - 1; XIY = XIY - 1; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
    if (BC != 0) goto inst_start;
}
:cpi A,(R32^"+") is op_hi=0x8 & op_3=0 & R32 ; op=0x14 & A {
    local m:1 = *:1 R32; local t:1 = 0; local cy:1 = $(C_flag); subf(A, m, 0, t); $(C_flag) = cy;
    R32 = R32 + 1; BC = BC - 1; $(V_flag) = BC != 0;
}
:cpir A,(R32^"+") is op_hi=0x8 & op_3=0 & R32 ; op=0x15 & A {
    local m:1 = *:1 R32; local t:1 = 0; local cy:1 = $(C_flag); subf(A, m, 0, t); $(C_flag) = cy;
    R32 = R32 + 1; BC = BC - 1; $(V_flag) = BC != 0;
    if ((BC != 0) && ($(Z_flag) == 0)) goto inst_start;
}
:cpd A,(R32^"-") is op_hi=0x8 & op_3=0 & R32 ; op=0x16 & A {
    local m:1 = *:1 R32; local t:1 = 0; local cy:1 = $(C_flag); subf(A, m, 0, t); $(C_flag) = cy;
    R32 = R32 - 1; BC = BC - 1; $(V_flag) = BC != 0;
}
:cpdr A,(R32^"-") is op_hi=0x8 & op_3=0 & R32 ; op=0x17 & A {
    local m:1 = *:1 R32; local t:1 = 0; local cy:1 = $(C_flag); subf(A, m, 0, t); $(C_flag) = cy;
    R32 = R32 - 1; BC = BC - 1; $(V_flag) = BC != 0;
    if ((BC != 0) && ($(Z_flag) == 0)) goto inst_start;
}
:ldiw (XDE^"+"),(XHL^"+") is op=0x93 & XDE & XHL ; op=0x10 {
    *:2 XDE = *:2 XHL; XDE = XDE + 2; XHL = XHL + 2; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
}
:ldirw (XDE^"+"),(XHL^"+") is op=0x93 & XDE & XHL ; op=0x11 {
    *:2 XDE = *:2 XHL; XDE = XDE + 2; XHL = XHL + 2; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
    if (BC != 0) goto inst_start;
}
:lddw (XDE^"-"),(XHL^"-") is op=0x93 & XDE & XHL ; op=0x12 {
    *:2 XDE = *:2 XHL; XDE = XDE - 2; XHL = XHL - 2; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
}
:lddrw (XDE^"-"),(XHL^"-") is op=0x93 & XDE & XHL ; op=0x13 {
    *:2 XDE = *:2 XHL; XDE = XDE - 2; XHL = XHL - 2; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
    if (BC != 0) goto inst_start;
}
:ldiw (XIX^"+"),(XIY^"+") is op=0x95 & XIX & XIY ; op=0x10 {
    *:2 XIX = *:2 XIY; XIX = XIX + 2; XIY = XIY + 2; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
}
:ldirw (XIX^"+"),(XIY^"+") is op=0x95 & XIX & XIY ; op=0x11 {
    *:2 XIX = *:2 XIY; XIX = XIX + 2; XIY = XIY + 2; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
    if (BC != 0) goto inst_start;
}
:lddw (XIX^"-"),(XIY^"-") is op=0x95 & XIX & XIY ; op=0x12 {
    *:2 XIX = *:2 XIY; XIX = XIX - 2; XIY = XIY - 2; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
}
:lddrw (XIX^"-"),(XIY^"-") is op=0x95 & XIX & XIY ; op=0x13 {
    *:2 XIX = *:2 XIY; XIX = XIX - 2; XIY = XIY - 2; BC = BC - 1;
    $(H_flag) = 0; $(N_flag) = 0; $(V_flag) = BC != 0;
    if (BC != 0) goto inst_start;
}
:cpi WA,(R32^"+") is op_hi=0x9 & op_3=0 & R32 ; op=0x14 & WA {
    local m:2 = *:2 R32; local t:2 = 0; local cy:1 = $(C_flag); subf(WA, m, 0, t); $(C_flag) = cy;
    R32 = R32 + 2; BC = BC - 1; $(V_flag) = BC != 0;
}
:cpir WA,(R32^"+") is op_hi=0x9 & op_3=0 & R32 ; op=0x15 & WA {
    local m:2 = *:2 R32; local t:2 = 0; local cy:1 = $(C_flag); subf(WA, m, 0, t); $(C_flag) = cy;
    R32 = R32 + 2; BC = BC - 1; $(V_flag) = BC != 0;
    if ((BC != 0) && ($(Z_flag) == 0)) goto inst_start;
}
:cpd WA,(R32^"-") is op_hi=0x9 & op_3=0 & R32 ; op=0x16 & WA {
    local m:2 = *:2 R32; local t:2 = 0; local cy:1 = $(C_flag); subf(WA, m, 0, t); $(C_flag) = cy;
    R32 = R32 - 2; BC = BC - 1; $(V_flag) = BC != 0;
}
:cpdr WA,(R32^"-") is op_hi=0x9 & op_3=0 & R32 ; op=0x17 & WA {
    local m:2 = *:2 R32; local t:2 = 0; local cy:1 = $(C_flag); subf(WA, m, 0, t); $(C_flag) = cy;
    R32 = R32 - 2; BC = BC - 1; $(V_flag) = BC != 0;
    if ((BC != 0) && ($(Z_flag) == 0)) goto inst_start;
}

# ---------------------------------------------------------------- first byte: dst (mem)
:ld (dmA_R),imm8     is dmA_R ; op=0x00 ; imm8  { *:1 dmA_R = imm8; }
:ld (dmA_Rd8),imm8     is dmA_Rd8 ; op=0x00 ; imm8  { *:1 dmA_Rd8 = imm8; }
:ld (dmA_n),imm8     is dmA_n ; op=0x00 ; imm8  { *:1 dmA_n = imm8; }
:ld (dmA_nn),imm8     is dmA_nn ; op=0x00 ; imm8  { *:1 dmA_nn = imm8; }
:ld (dmA_nnn),imm8     is dmA_nnn ; op=0x00 ; imm8  { *:1 dmA_nnn = imm8; }
:ld (dmA_r),imm8     is dmA_r ; op=0x00 ; imm8  { *:1 dmA_r = imm8; }
:ld (dmA_rd16),imm8     is dmA_rd16 ; op=0x00 ; imm8  { *:1 dmA_rd16 = imm8; }
:ld (dmA_rr8),imm8     is dmA_rr8 ; op=0x00 ; imm8  { *:1 dmA_rr8 = imm8; }
:ld (dmA_rr16),imm8     is dmA_rr16 ; op=0x00 ; imm8  { *:1 dmA_rr16 = imm8; }
:ld (dmA_dec),imm8     is dmA_dec ; op=0x00 ; imm8  { *:1 dmA_dec = imm8; }
:ld (dmA_inc),imm8     is dmA_inc ; op=0x00 ; imm8  { *:1 dmA_inc = imm8; }
:ldw (dmA_R),imm16   is dmA_R ; op=0x02 ; imm16 { *:2 dmA_R = imm16; }
:ldw (dmA_Rd8),imm16   is dmA_Rd8 ; op=0x02 ; imm16 { *:2 dmA_Rd8 = imm16; }
:ldw (dmA_n),imm16   is dmA_n ; op=0x02 ; imm16 { *:2 dmA_n = imm16; }
