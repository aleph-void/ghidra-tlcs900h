:ldw (dmA_r),imm16   is dmA_r ; op=0x02 ; imm16 { *:2 dmA_r = imm16; }
:ldw (dmA_rd16),imm16   is dmA_rd16 ; op=0x02 ; imm16 { *:2 dmA_rd16 = imm16; }
:ldw (dmA_rr8),imm16   is dmA_rr8 ; op=0x02 ; imm16 { *:2 dmA_rr8 = imm16; }
:ldw (dmA_rr16),imm16   is dmA_rr16 ; op=0x02 ; imm16 { *:2 dmA_rr16 = imm16; }
:ldw (dmA_dec),imm16   is dmA_dec ; op=0x02 ; imm16 { *:2 dmA_dec = imm16; }
:ldw (dmA_inc),imm16   is dmA_inc ; op=0x02 ; imm16 { *:2 dmA_inc = imm16; }
:pop (dmA_R)         is dmA_R ; op=0x04 { local v:1 = 0; pop8(v); *:1 dmA_R = v; }
:pop (dmA_Rd8)         is dmA_Rd8 ; op=0x04 { local v:1 = 0; pop8(v); *:1 dmA_Rd8 = v; }
:pop (dmA_n)         is dmA_n ; op=0x04 { local v:1 = 0; pop8(v); *:1 dmA_n = v; }
:pop (dmA_nn)         is dmA_nn ; op=0x04 { local v:1 = 0; pop8(v); *:1 dmA_nn = v; }
:pop (dmA_nnn)         is dmA_nnn ; op=0x04 { local v:1 = 0; pop8(v); *:1 dmA_nnn = v; }
